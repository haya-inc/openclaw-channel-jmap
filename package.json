{
  "name": "openclaw-channel-jmap",
  "version": "0.1.5",
  "description": "A safe, multi-account JMAP email channel and mail tools for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "Haya Inc.",
  "contributors": [
    "Kai <kai@thekaiway.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haya-inc/openclaw-channel-jmap.git"
  },
  "bugs": {
    "url": "https://github.com/haya-inc/openclaw-channel-jmap/issues"
  },
  "homepage": "https://github.com/haya-inc/openclaw-channel-jmap#readme",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.3"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "openclaw": "2026.7.2-beta.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "jmap",
      "label": "JMAP Email",
      "selectionLabel": "JMAP Email",
      "docsPath": "/channels/jmap",
      "docsLabel": "jmap",
      "blurb": "Provider-neutral email conversations and mailbox tools over JMAP.",
      "aliases": [
        "jmail",
        "jmap-email"
      ],
      "order": 85,
      "quickstartAllowFrom": true
    },
    "install": {
      "localPath": "extensions/jmap",
      "defaultChoice": "npm"
    }
  }
}
