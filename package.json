{
  "name": "openclaw-channel-jmap",
  "version": "0.4.1",
  "description": "A safe, multi-account JMAP email channel and mail tools for OpenClaw",
  "keywords": [
    "openclaw",
    "jmap",
    "email",
    "stalwart",
    "fastmail",
    "cyrus",
    "apache-james"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Haya Inc.",
  "contributors": [
    "Kai <kai@thekaiway.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haya-inc/openclaw-channel-jmap.git"
  },
  "bugs": {
    "url": "https://github.com/haya-inc/openclaw-channel-jmap/issues"
  },
  "homepage": "https://github.com/haya-inc/openclaw-channel-jmap#readme",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "openclaw-jmap-compat": "./dist/src/compatibility-bin.js",
    "openclaw-jmap-draft-contract": "./dist/src/stateful-contract-bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "compatibility-requirements.json",
    "release-gates.json",
    "rfc8621-coverage.json",
    "compatibility-evidence.schema.json",
    "compatibility-report.schema.json",
    "stateful-contract-report.schema.json",
    "docs",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm run compatibility:evidence:check && npm pack --dry-run",
    "compatibility:evidence": "node scripts/compatibility/verify-evidence.mjs",
    "compatibility:evidence:check": "node scripts/compatibility/verify-evidence.mjs --allow-incomplete",
    "compatibility:generic-fixture": "node scripts/compatibility/run-generic-fixture.mjs",
    "compatibility:draft-contract": "node dist/src/stateful-contract-bin.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.3"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openclaw": "2026.7.2-beta.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "jmap",
      "label": "JMAP Email",
      "selectionLabel": "JMAP Email",
      "docsPath": "/channels/jmap",
      "docsLabel": "jmap",
      "blurb": "Provider-neutral email conversations and mailbox tools over JMAP.",
      "aliases": [
        "jmail",
        "jmap-email"
      ],
      "order": 85,
      "quickstartAllowFrom": true
    },
    "install": {
      "localPath": "extensions/jmap",
      "defaultChoice": "npm"
    }
  }
}
