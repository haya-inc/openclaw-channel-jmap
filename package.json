{
  "name": "openclaw-channel-jmap-email",
  "version": "2026.2.15",
  "description": "JMAP email channel plugin for OpenClaw",
  "type": "module",
  "devDependencies": {
    "openclaw": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "jmap-email",
      "label": "JMAP Email",
      "selectionLabel": "JMAP Email",
      "docsPath": "/channels/jmap-email",
      "docsLabel": "jmap-email",
      "blurb": "Email thread conversations over JMAP.",
      "aliases": [
        "jmap",
        "jmail"
      ],
      "order": 85,
      "quickstartAllowFrom": true
    },
    "install": {
      "localPath": "extensions/jmap",
      "defaultChoice": "git"
    }
  }
}
